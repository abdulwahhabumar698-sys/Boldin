# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VTU API Integration (e.g., VTpass, Bilalsada, Husmodata)
VTU_PROVIDER=vtpass
VTU_BASE_URL=https://sandbox.vtpass.com/api
VTU_API_KEY=
VTU_SECRET_KEY=

# Payment Gateway Integration (Paystack / Monnify)
PAYSTACK_SECRET_KEY=
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=

# OTP Delivery Provider (Optional: Termii SMS or Resend Email)
TERMII_API_KEY=
RESEND_API_KEY=
